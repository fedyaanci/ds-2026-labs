@page
@model Valuator.Pages.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<h1>Вход</h1>
@if (Model.Registered)
{
    <div class="alert alert-success">Регистрация завершена. Теперь войдите.</div>
}
<form method="post" class="col-md-5">
    <input type="hidden" asp-for="ReturnUrl" />
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Login" class="form-label"></label>
        <input asp-for="Login" class="form-control" autocomplete="username" />
    </div>
    <div class="mb-3">
        <label asp-for="Password" class="form-label"></label>
        <input asp-for="Password" class="form-control" autocomplete="current-password" />
    </div>
    <button type="submit" class="btn btn-primary">Войти</button>
</form>
